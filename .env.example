# ==============================================================================
# SIP-BRIDA - Environment Configuration
# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
#   cp .env.example .env
# ==============================================================================

# --- Database -----------------------------------------------------------------
# Jalur utama: PostgreSQL (via Docker Compose, lihat docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/idp_db
# Jika PostgreSQL tidak tersedia, aplikasi otomatis jatuh ke SQLite:
#   storage/idp_local.db

# --- AI Provider --------------------------------------------------------------
# Kunci gratis dari https://aistudio.google.com/app/apikey
# KOSONG = Stage 3 otomatis memakai Smart Heuristic Extractor (offline).
# PENTING: selama kunci ini kosong, hasil "Iterasi 3 (Full AI)" pada benchmark
# akan IDENTIK dengan "Iterasi 2", karena jalur AI tidak pernah benar-benar aktif.
GEMINI_API_KEY=

# Model multimodal yang dipakai Stage 3
GEMINI_MODEL=gemini-2.5-flash

# --- Kebijakan privasi pengiriman ke AI Vision --------------------------------
# scanned_only = HANYA halaman dokumen tanpa lapisan teks (hasil scan) yang dikirim.
#                Dokumen digital-native selalu diproses lokal, tidak pernah keluar.
# off          = tidak pernah mengirim apa pun ke API (mode lokal penuh)
# all          = semua dokumen boleh dikirim (PERLU PERSETUJUAN eksplisit)
# PDF utuh TIDAK PERNAH dikirim - yang keluar hanya citra halaman, maksimal 4 halaman
# per permintaan. Setiap pengiriman/penolakan dicatat di storage/audit_kirim_api.jsonl
GEMINI_VISION_POLICY=scanned_only

# --- OCR lokal (di dalam venv, offline) --------------------------------------
# auto | rapidocr | tesseract | none
OCR_ENGINE=auto

# --- Aplikasi -----------------------------------------------------------------
DEBUG=True
APP_PORT=8000
LOG_LEVEL=INFO

# --- Direktori Data (relatif terhadap root repo) ------------------------------
DOCUMENTS_DIR=data/raw/evidence
DATASETS_DIR=data/datasets
REFERENCE_DIR=data/reference
