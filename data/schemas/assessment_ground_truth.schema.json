{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sip-brida/schemas/assessment_ground_truth.schema.json",
  "title": "Assessment Ground Truth - label penilaian indikator (per parameter)",
  "description": "Ini LABEL untuk pengembangan ML penilaian indikator. Satu entri = satu parameter indikator untuk satu usulan inovasi. Wajib mencatat anotator dan versi pedoman supaya bisa diaudit.",
  "type": "object",
  "required": ["inovasi_id", "pedoman_version", "annotations"],
  "additionalProperties": false,
  "properties": {
    "inovasi_id": { "type": "string" },
    "pedoman_version": { "type": "string", "description": "Versi katalog indikator, contoh 2026.1" },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["indicator_id", "parameter_id", "label", "annotator", "annotated_at"],
        "additionalProperties": false,
        "properties": {
          "indicator_id": { "type": "string", "pattern": "^IND-[0-9]{2}$" },
          "parameter_id": { "type": "string", "pattern": "^IND-[0-9]{2}-P[1-3]$" },
          "label": {
            "type": "string",
            "enum": ["TERPENUHI", "TIDAK_TERPENUHI", "TIDAK_DAPAT_DINILAI"],
            "description": "Apakah parameter ini terbukti terpenuhi oleh bukti yang ada"
          },
          "skor_diberikan": { "type": ["number", "null"], "description": "Diisi hanya jika label TERPENUHI" },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Bukti yang menjadi dasar label - wajib untuk audit"
          },
          "alasan": { "type": "string", "description": "Justifikasi singkat, 1-2 kalimat" },
          "annotator": { "type": "string", "description": "Inisial/nama anotator manusia" },
          "annotated_at": { "type": "string", "format": "date-time" },
          "sumber": {
            "type": "string",
            "enum": ["anotasi_manual", "koreksi_hasil_ai", "keputusan_hitl"],
            "description": "anotasi_manual = dari nol oleh manusia; koreksi_hasil_ai = pre-label AI lalu diverifikasi; keputusan_hitl = keputusan reviewer saat produksi"
          },
          "double_annotated_by": { "type": ["string", "null"], "description": "Anotator kedua untuk mengukur agreement (minimal 15-20% sampel)" },
          "label_annotator_2": { "type": ["string", "null"], "enum": ["TERPENUHI", "TIDAK_TERPENUHI", "TIDAK_DAPAT_DINILAI", null] }
        }
      }
    }
  }
}
